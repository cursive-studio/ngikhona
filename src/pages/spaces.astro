---
import Layout from "../layouts/Layout.astro";
import SpaceRoomDetail from "../components/SpaceRoomDetail.astro";
import SpacesEnquirySection from "../components/SpacesEnquirySection.astro";

const title = "Therapy rooms to rent — Ngikhona";
const description =
	"Therapy rooms available to rent in South London. Quiet consulting spaces for clinicians in Camberwell and surrounding areas.";

const roomOneDetails = [
	{ label: "Size", value: "Approx. 14 m² (placeholder)" },
	{ label: "Capacity", value: "Up to 2 people" },
	{ label: "Price", value: "From £XX / session (placeholder)" },
	{ label: "Availability", value: "Weekdays, daytime" },
];

const roomTwoDetails = [
	{ label: "Size", value: "Approx. 12 m² (placeholder)" },
	{ label: "Capacity", value: "Up to 2 people" },
	{ label: "Price", value: "From £XX / session (placeholder)" },
	{ label: "Availability", value: "Weekdays & limited evenings" },
];
---

<Layout {title} {description}>
	<section
		id="top"
		class="border-b border-neutral-200/80 bg-white"
		aria-labelledby="spaces-hero-heading"
		style={`padding-top: var(--spacing-section-y); padding-bottom: var(--spacing-section-y);`}
	>
		<div class="mx-auto max-w-6xl px-6 lg:px-8">
			<div class="max-w-3xl">
				<h1
					id="spaces-hero-heading"
					class="text-4xl font-semibold leading-tight tracking-tight text-neutral-900 md:text-5xl lg:text-6xl"
				>
					Therapy rooms available to rent in South London
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600">
					Quiet, well-appointed consulting rooms for qualified clinicians. Replace this paragraph
					with details about the building, access, shared facilities, and what makes the space
					suitable for therapeutic work.
				</p>
				<div class="mt-8">
					<a
						href="#enquire"
						class="inline-flex items-center justify-center rounded-sm bg-neutral-200 px-6 py-3 text-sm font-medium text-neutral-900 transition-colors hover:bg-neutral-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
					>
						Get in touch
					</a>
				</div>
			</div>
		</div>
	</section>

	<SpaceRoomDetail
		title="Room one"
		description="Placeholder description: natural light, comfortable seating, and sound-treated doors suitable for confidential conversation. Summarise what a renter can expect when using this room day to day."
		details={roomOneDetails}
		imagesFirst={true}
	/>

	<SpaceRoomDetail
		title="Room two"
		description="Placeholder description: a second consulting space with its own character — note differences in size, aspect, or furnishings compared with room one so visitors can choose what suits their practice."
		details={roomTwoDetails}
		imagesFirst={false}
	/>

	<SpacesEnquirySection />
</Layout>
