---
import "@fontsource-variable/inter";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	headerVariant?: "default" | "overlay";
}

const {
	title = "Ngikhona — Psychotherapy in South London",
	description = "Psychotherapy services and therapy spaces in South London. Ngikhona offers thoughtful, human-centred care.",
	headerVariant = "default",
} = Astro.props;

const nav = [
	{ href: "/#services", label: "Services" },
	{ href: "/#team", label: "Team" },
	{ href: "/spaces", label: "Spaces" },
	{ href: "/#contact", label: "Contact" },
];

const year = new Date().getFullYear();
const isOverlay = headerVariant === "overlay";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col">
		<a
			href="#main-content"
			class="absolute left-[-9999px] top-0 z-100 whitespace-nowrap rounded bg-neutral-900 px-4 py-2 text-white focus:left-4 focus:top-4 focus:outline-none"
		>
			Skip to main content
		</a>
		<header
			data-site-header
			class:list={[
				"site-header z-40 w-full",
				isOverlay
					? "site-header--overlay fixed top-0 left-0 text-white"
					: "sticky top-0 text-brand-ink",
			]}
		>
			<div class="grid w-full grid-cols-[1fr_auto] items-center gap-6 px-4 py-5 md:grid-cols-[1fr_auto_1fr] md:px-12 md:py-6">
				<a
					href="/"
					class="inline-flex min-h-11 items-center gap-2.5 text-base font-normal tracking-[-0.01em] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current"
					aria-label="Ngikhona home"
				>
					<img
						src="/images/hona-logo-latest.svg"
						alt=""
						class:list={["header-logo h-9 w-auto md:h-10", isOverlay ? "" : "brightness-0"]}
					/>
					<span class="font-brand text-lg leading-none font-normal md:text-xl">Ngikhona</span>
				</a>

				<nav
					class="hidden items-center gap-9 md:flex"
					aria-label="Primary"
				>
					{
						nav.map((item) => (
							<a
								href={item.href}
								class:list={[
									"header-nav-link relative flex min-h-11 items-center text-[0.95rem] font-normal transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-current after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform hover:after:scale-x-100",
									isOverlay
										? "text-white/90 hover:text-white"
										: "text-brand-muted hover:text-brand-ink",
								]}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<a
					href="/#contact"
					class="hidden min-h-11 items-center justify-center justify-self-end rounded-[9px] bg-brand-sand px-6 py-2.5 text-sm font-normal text-brand-ink transition-[background-color,transform] duration-150 hover:bg-brand-mint active:scale-[0.96] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current md:inline-flex"
				>
					Book an appointment
				</a>

				<button
					type="button"
					id="menu-toggle"
					class="flex h-11 w-11 items-center justify-center justify-self-end rounded-sm md:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
					aria-expanded="false"
					aria-controls="mobile-nav"
					aria-label="Open menu"
				>
					<svg
						class="h-6 w-6"
						aria-hidden="true"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
					>
						<path d="M4 7h16" />
						<path d="M4 12h16" />
						<path d="M4 17h16" />
					</svg>
				</button>
			</div>
		</header>

		<div
			id="mobile-nav"
			class="mobile-nav-overlay fixed inset-0 z-50 hidden min-h-dvh w-full flex-col bg-white md:hidden"
			aria-hidden="true"
			role="dialog"
			aria-modal="true"
			aria-label="Site menu"
		>
			<div class="flex shrink-0 items-center justify-end border-b border-neutral-200/80 px-6 py-4">
				<button
					type="button"
					id="menu-close"
					class="flex h-11 w-11 items-center justify-center rounded-sm text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
					aria-label="Close menu"
				>
					<svg class="h-6 w-6" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
						<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
					</svg>
				</button>
			</div>
			<nav
				class="flex flex-1 flex-col items-center justify-center gap-10 px-6 pb-16"
				aria-label="Primary"
			>
				{
					nav.map((item) => (
						<a
							href={item.href}
							class="text-center text-xl font-medium text-neutral-800 transition-colors hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
						>
							{item.label}
						</a>
					))
				}
			</nav>
		</div>

		<main id="main-content" class="flex-1">
			<slot />
		</main>
		<footer class="bg-white py-10 text-brand-ink">
			<div class="site-grid gap-y-10 md:gap-y-6">
				<div class="col-span-4 md:col-start-1 md:col-span-3">
					<a
						href="/"
						class="inline-flex min-h-11 items-center gap-3 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-ink"
						aria-label="Ngikhona home"
					>
						<img
							src="/images/hona-logo-latest.svg"
							alt=""
							class="h-12 w-auto brightness-0"
						/>
						<span class="font-brand text-2xl md:text-3xl! leading-none">Ngikhona</span>
					</a>
					<p class="mt-4 max-w-44 text-[0.8125rem] leading-[1.4] text-brand-ink">
						Psychotherapy services in <br />South London.
					</p>
				</div>

				<div class="col-span-4 grid grid-cols-2 gap-8 md:col-start-10 md:col-span-4 md:gap-12">
					<nav aria-label="Footer navigation">
						<h2 class="mb-3 text-sm font-semibold">Navigation</h2>
						<ul class="text-sm" role="list">
							<li><a href="/#services" class="inline-flex min-h-10 items-center hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-ink md:min-h-6">Services</a></li>
							<li><a href="/spaces" class="inline-flex min-h-10 items-center hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-ink md:min-h-6">Rooms</a></li>
							<li><a href="/#contact" class="inline-flex min-h-10 items-center hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-ink md:min-h-6">Contact</a></li>
						</ul>
					</nav>

					<div>
						<h2 class="mb-3 text-sm font-semibold">Contact Us</h2>
						<a
							href="mailto:hello@ngikhona.co.uk"
							class="inline-flex min-h-10 items-center text-sm underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-ink md:min-h-6"
						>
							hello@ngikhona.co.uk
						</a>
					</div>
				</div>

				<div class="col-span-4 border-t border-brand-ink/20 pt-5 md:col-start-1 md:col-span-12 md:mt-1">
					<div class="flex flex-col gap-3 text-[0.8125rem] sm:flex-row sm:items-center sm:justify-between">
						<p>{year} <strong class="font-semibold">Ngikhona.</strong> All rights reserved.</p>
						<p>Built by <span class="underline">Cursive Studios</span></p>
					</div>
				</div>
			</div>
		</footer>

		<style>
			.site-header {
				border-bottom: 1px solid transparent;
				background-color: transparent;
				transition-property: background-color, border-color, color, box-shadow;
				transition-duration: 180ms;
				transition-timing-function: ease-out;
			}

			.site-header.is-scrolled {
				border-bottom-color: rgb(32 40 39 / 10%);
				background-color: rgb(255 255 255 / 96%);
				box-shadow: 0 1px 0 rgb(0 0 0 / 3%);
				color: #202827;
				backdrop-filter: blur(12px);
			}

			.site-header--overlay.is-scrolled .header-logo {
				filter: brightness(0);
			}

			.site-header--overlay.is-scrolled .header-nav-link {
				color: #53605d;
			}

			.site-header--overlay.is-scrolled .header-nav-link:hover {
				color: #202827;
			}
		</style>

		<script is:inline>
			function initSiteHeader() {
				const header = document.querySelector("[data-site-header]");
				if (!header) return;

				const updateHeader = () => {
					header.classList.toggle("is-scrolled", window.scrollY > 8);
				};

				updateHeader();
				window.addEventListener("scroll", updateHeader, { passive: true });
			}

			function initMobileNav() {
				const toggle = document.getElementById("menu-toggle");
				const closeBtn = document.getElementById("menu-close");
				const overlay = document.getElementById("mobile-nav");
				if (!toggle || !overlay) return;

				const open = () => {
					overlay.classList.remove("hidden");
					overlay.classList.add("flex");
					overlay.setAttribute("aria-hidden", "false");
					toggle.setAttribute("aria-expanded", "true");
					toggle.setAttribute("aria-label", "Close menu");
					document.body.classList.add("overflow-hidden");
					closeBtn?.focus();
				};

				const shut = () => {
					overlay.classList.add("hidden");
					overlay.classList.remove("flex");
					overlay.setAttribute("aria-hidden", "true");
					toggle.setAttribute("aria-expanded", "false");
					toggle.setAttribute("aria-label", "Open menu");
					document.body.classList.remove("overflow-hidden");
					toggle.focus();
				};

				toggle.addEventListener("click", () => {
					if (overlay.classList.contains("hidden")) open();
					else shut();
				});

				closeBtn?.addEventListener("click", shut);

				overlay.querySelectorAll("a").forEach((link) => {
					link.addEventListener("click", shut);
				});

				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && !overlay.classList.contains("hidden")) shut();
				});
			}

			initSiteHeader();
			initMobileNav();
		</script>
	</body>
</html>
