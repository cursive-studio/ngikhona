---
const formAction =
	typeof import.meta.env.PUBLIC_FORMSPREE_ID === "string" &&
	import.meta.env.PUBLIC_FORMSPREE_ID.length > 0
		? `https://formspree.io/f/${import.meta.env.PUBLIC_FORMSPREE_ID}`
		: undefined;

const roomOptions = ["Room one", "Room two", "Either / not sure"];
---

<section
	id="enquire"
	class="border-b border-neutral-200/80 bg-neutral-100"
	aria-labelledby="spaces-enquiry-heading"
	style={`padding-top: var(--spacing-section-y); padding-bottom: var(--spacing-section-y);`}
>
	<div class="mx-auto max-w-6xl px-6 lg:px-8">
		<div class="mx-auto max-w-3xl text-center">
			<h2
				id="spaces-enquiry-heading"
				class="text-3xl font-semibold tracking-tight text-neutral-900 md:text-4xl"
			>
				Enquire about a space
			</h2>
			<p class="mt-4 text-base text-neutral-600 md:text-lg">
				Please fill out the form below.
			</p>
		</div>

		<div
			class="mx-auto mt-12 max-w-2xl rounded-sm border border-neutral-200/80 bg-white p-8 shadow-sm md:p-10 lg:p-12"
		>
			<form class="flex flex-col gap-8" name="space-enquiry" method="POST" action={formAction}>
				{
					formAction ? (
						<>
							<input type="hidden" name="_subject" value="Ngikhona — space rental enquiry" />
						</>
					) : (
						<p class="rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
							Add{" "}
							<code class="rounded bg-white px-1 py-0.5 text-xs">PUBLIC_FORMSPREE_ID</code> to your{" "}
							<code class="rounded bg-white px-1 py-0.5 text-xs">.env</code> file to enable form
							submissions (Formspree).
						</p>
					)
				}

				<div class="grid gap-8 sm:grid-cols-2 sm:gap-6">
					<div class="flex flex-col gap-2">
						<label
							for="spaces-enquiry-name"
							class="text-xs font-medium tracking-widest text-neutral-500 uppercase"
						>
							Name
						</label>
						<input
							id="spaces-enquiry-name"
							type="text"
							name="name"
							required
							autocomplete="name"
							class="w-full border-0 border-b border-neutral-400 bg-transparent pb-2 text-base text-neutral-900 outline-none transition-colors focus:border-neutral-900"
						/>
					</div>
					<div class="flex flex-col gap-2">
						<label
							for="spaces-enquiry-email"
							class="text-xs font-medium tracking-widest text-neutral-500 uppercase"
						>
							Email
						</label>
						<input
							id="spaces-enquiry-email"
							type="email"
							name="email"
							required
							autocomplete="email"
							class="w-full border-0 border-b border-neutral-400 bg-transparent pb-2 text-base text-neutral-900 outline-none transition-colors focus:border-neutral-900"
						/>
					</div>
				</div>

				<div class="flex flex-col gap-2">
					<label
						for="spaces-enquiry-room"
						class="text-xs font-medium tracking-widest text-neutral-500 uppercase"
					>
						Preferred room
					</label>
					<div class="relative">
						<select
							id="spaces-enquiry-room"
							name="preferred_room"
							required
							class="spaces-enquiry-select w-full cursor-pointer appearance-none border-0 border-b border-neutral-400 bg-transparent pb-2 pr-8 text-base text-neutral-900 outline-none transition-colors focus:border-neutral-900"
						>
							{
								roomOptions.map((label) => (
									<option value={label}>{label}</option>
								))
							}
						</select>
						<span
							class="pointer-events-none absolute right-0 bottom-2 text-neutral-500"
							aria-hidden="true"
						>
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
					</div>
				</div>

				<div class="flex flex-col gap-2">
					<label
						for="spaces-enquiry-message"
						class="text-xs font-medium tracking-widest text-neutral-500 uppercase"
					>
						Message
					</label>
					<textarea
						id="spaces-enquiry-message"
						name="message"
						required
						rows="5"
						class="min-h-[140px] w-full resize-y border-0 border-b border-neutral-400 bg-transparent pb-2 text-base leading-relaxed text-neutral-900 outline-none transition-colors focus:border-neutral-900"
					/>
				</div>

				<button
					type="submit"
					disabled={!formAction}
					class="w-full bg-neutral-900 px-6 py-3.5 text-sm font-medium text-white transition-colors hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 disabled:cursor-not-allowed disabled:opacity-50"
				>
					Send enquiry
				</button>
			</form>
		</div>
	</div>
</section>

<style>
	.spaces-enquiry-select {
		background-image: none;
	}
</style>
