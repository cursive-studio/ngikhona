---
const formAction =
	typeof import.meta.env.PUBLIC_FORMSPREE_ID === "string" &&
	import.meta.env.PUBLIC_FORMSPREE_ID.length > 0
		? `https://formspree.io/f/${import.meta.env.PUBLIC_FORMSPREE_ID}`
		: undefined;

const roomOptions = ["Room one", "Room two", "Either / not sure"];
---

<section
	id="enquire"
	class="spaces-enquiry-section border-b border-brand-ink/10"
	aria-labelledby="spaces-enquiry-heading"
>
	<div class="site-grid items-start gap-y-12">
		<header class="col-span-4 md:col-span-5">
			<p class="mb-7 text-sm leading-none font-normal text-brand-ink">Availability</p>
			<h2
				id="spaces-enquiry-heading"
				class="spaces-enquiry-title font-brand max-w-[28rem] font-normal tracking-[-0.035em] text-brand-ink [text-wrap:balance]"
			>
				Enquire about a space
			</h2>
			<p class="mt-6 max-w-sm text-base leading-[1.5] text-brand-muted md:text-lg">
				Please fill out the form below.
			</p>
		</header>

		<div class="col-span-4 border-t border-brand-ink/20 pt-8 md:col-start-7 md:col-span-6 md:pt-10">
			<form class="flex flex-col gap-8" name="space-enquiry" method="POST" action={formAction}>
				{formAction && <input type="hidden" name="_subject" value="Ngikhona — space rental enquiry" />}

				<div class="grid gap-8 sm:grid-cols-2 sm:gap-6">
					<div class="flex flex-col gap-2">
						<label
							for="spaces-enquiry-name"
							class="text-xs font-medium tracking-widest text-neutral-500 uppercase"
						>
							Name
						</label>
						<input
							id="spaces-enquiry-name"
							type="text"
							name="name"
							required
							autocomplete="name"
							class="w-full border-0 border-b border-neutral-400 bg-transparent pb-2 text-base text-neutral-900 outline-none transition-colors focus:border-neutral-900"
						/>
					</div>
					<div class="flex flex-col gap-2">
						<label
							for="spaces-enquiry-email"
							class="text-xs font-medium tracking-widest text-neutral-500 uppercase"
						>
							Email
						</label>
						<input
							id="spaces-enquiry-email"
							type="email"
							name="email"
							required
							autocomplete="email"
							class="w-full border-0 border-b border-neutral-400 bg-transparent pb-2 text-base text-neutral-900 outline-none transition-colors focus:border-neutral-900"
						/>
					</div>
				</div>

				<div class="flex flex-col gap-2">
					<label
						for="spaces-enquiry-room"
						class="text-xs font-medium tracking-widest text-neutral-500 uppercase"
					>
						Preferred room
					</label>
					<div class="relative">
						<select
							id="spaces-enquiry-room"
							name="preferred_room"
							required
							class="spaces-enquiry-select w-full cursor-pointer appearance-none border-0 border-b border-neutral-400 bg-transparent pb-2 pr-8 text-base text-neutral-900 outline-none transition-colors focus:border-neutral-900"
						>
							{
								roomOptions.map((label) => (
									<option value={label}>{label}</option>
								))
							}
						</select>
						<span
							class="pointer-events-none absolute right-0 bottom-2 text-neutral-500"
							aria-hidden="true"
						>
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
					</div>
				</div>

				<div class="flex flex-col gap-2">
					<label
						for="spaces-enquiry-message"
						class="text-xs font-medium tracking-widest text-neutral-500 uppercase"
					>
						Message
					</label>
					<textarea
						id="spaces-enquiry-message"
						name="message"
						required
						rows="5"
						class="min-h-[140px] w-full resize-y border-0 border-b border-neutral-400 bg-transparent pb-2 text-base leading-relaxed text-neutral-900 outline-none transition-colors focus:border-neutral-900"
					/>
				</div>

				<button
					type="submit"
					disabled={!formAction}
					class="min-h-11 w-fit rounded-sm bg-brand-sand px-6 py-3 text-sm font-medium text-brand-ink transition-colors hover:bg-brand-ink hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-ink disabled:cursor-not-allowed disabled:border disabled:border-brand-muted/35 disabled:bg-transparent disabled:text-brand-muted"
				>
					Send enquiry
				</button>
			</form>
		</div>
	</div>
</section>

<style>
	.spaces-enquiry-section {
		background: #f5f3ee;
		padding-block: 5rem;
	}

	.spaces-enquiry-title {
		font-size: 2.5rem;
		line-height: 1.05;
	}

	.spaces-enquiry-select {
		background-image: none;
	}

	@media (min-width: 48rem) {
		.spaces-enquiry-section {
			padding-block: 6.5rem;
		}

		.spaces-enquiry-title {
			font-size: 3rem;
		}
	}
</style>
