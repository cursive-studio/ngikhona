---
import Button from "./Button.astro";

const heroImage = {
	src: "/images/hona-hero.png",
	alt: "Orange flowers in soft focus against a clear blue sky.",
};
---

<section
	id="top"
	class="relative flex min-h-[100svh] overflow-hidden bg-brand-ink text-white md:min-h-[700px] lg:min-h-[min(900px,100svh)]"
	aria-labelledby="hero-heading"
>
	<img
		src={heroImage.src}
		alt={heroImage.alt}
		class="absolute inset-0 h-full w-full object-cover object-[62%_center] md:object-center"
		loading="eager"
		decoding="async"
		fetchpriority="high"
	/>
	<div class="site-grid relative z-10 grow gap-y-8 pt-28 pb-5 md:pt-32 md:pb-16 lg:pb-20">
		<div class="col-span-4 self-end bg-[#f7f7f9] px-6 py-8 text-brand-ink sm:px-8 md:col-span-7 md:self-center md:p-10 lg:col-span-5 lg:translate-y-16">
			<h1
				id="hero-heading"
				class="font-brand text-[2.55rem] font-normal leading-[1.06] tracking-[-0.035em] text-brand-ink [text-wrap:balance] md:text-5xl lg:text-[3.45rem]"
			>
				Psychotherapy services, grounded in presence.
			</h1>
			<div class="mt-7 h-0.5 w-28 bg-brand-sand" aria-hidden="true"></div>
			<p class="mt-5 max-w-[30rem] text-[0.95rem] font-normal leading-[1.5] text-brand-ink [text-wrap:pretty] md:text-base">
				We aim to provide a service to the community in South London, where we have worked
				for some while.
			</p>
			<div class="mt-7 flex flex-wrap gap-3 md:mt-8">
				<Button href="#contact" class="rounded-[9px]">Book an appointment</Button>
				<Button href="/spaces" variant="outline" class="rounded-[9px] border-brand-sage text-brand-sage hover:border-brand-ink">Explore our spaces</Button>
			</div>
		</div>

		<blockquote class="col-span-4 self-end justify-self-end text-right text-sm font-normal leading-[1.5] text-white [text-wrap:pretty] md:col-start-9 md:col-span-4 md:max-w-64 md:text-base lg:col-start-11 lg:col-span-2">
			<p>
				Ngikhona means &quot;I am here&quot;: to be present with another with the fullness of their
				identity.
			</p>
		</blockquote>
	</div>
</section>
