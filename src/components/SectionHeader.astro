---
interface Props {
	label: string;
	title: string;
	class?: string;
	titleId?: string;
}

const { label, title, class: className = "", titleId } = Astro.props;
---

<header class:list={["mb-10 md:mb-14", className]}>
	<p class="mb-3 text-xs font-medium tracking-widest text-neutral-500 uppercase">
		{label}
	</p>
	<h2
		id={titleId}
		class="max-w-3xl text-3xl font-semibold leading-tight tracking-tight text-neutral-900 md:text-4xl lg:text-5xl"
	>
		{title}
	</h2>
</header>
