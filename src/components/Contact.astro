---
const formAction =
	typeof import.meta.env.PUBLIC_FORMSPREE_ID === "string" &&
	import.meta.env.PUBLIC_FORMSPREE_ID.length > 0
		? `https://formspree.io/f/${import.meta.env.PUBLIC_FORMSPREE_ID}`
		: undefined;

const enquiryOptions = [
	"1:1 Psychotherapy",
	"Group therapy",
	"Child psychotherapy",
	"Body work",
	"Teaching or training",
	"Spaces to rent",
	"Other",
];
---

<section id="contact" class="contact-section py-20 md:py-[6.5rem]" aria-labelledby="contact-heading">
	<div class="contact-layout">
		<div class="contact-intro">
			<h2
				id="contact-heading"
				class="font-brand text-[26px] leading-[1.05] font-normal tracking-[-0.035em] text-brand-ink [text-wrap:balance] md:text-[28px]"
			>
				Get in touch
			</h2>
			<p class="mt-6 max-w-[23rem] text-base leading-[1.5] font-normal text-brand-ink [text-wrap:pretty]">
				We’re here to help you find the right support.<br />
				Send us an enquiry and we’ll be in touch within 2 working days.
			</p>

			<address class="contact-details mt-16 flex flex-col gap-2 text-base leading-[1.5] font-normal text-brand-ink not-italic">
				<a href="mailto:hello@ngikhona.co.uk">Email: hello@ngikhona.co.uk</a>
				<span>Camberwell, South London</span>
			</address>
		</div>

		<form class="contact-form flex min-w-0 flex-col pt-5" name="contact" method="POST" action={formAction}>
			{formAction && <input type="hidden" name="_subject" value="Ngikhona website enquiry" />}

			<div class="grid gap-10 sm:grid-cols-2 sm:gap-x-12 md:gap-x-16 xl:gap-x-[5.75rem]">
				<div class="contact-field flex min-w-0 flex-col">
					<label class="text-xs leading-none font-normal uppercase" for="contact-name">Name</label>
					<input class="text-base leading-[1.5] font-normal" id="contact-name" type="text" name="name" required autocomplete="name" />
				</div>
				<div class="contact-field flex min-w-0 flex-col">
					<label class="text-xs leading-none font-normal uppercase" for="contact-email">Email</label>
					<input class="text-base leading-[1.5] font-normal" id="contact-email" type="email" name="email" required autocomplete="email" />
				</div>
			</div>

			<div class="contact-field mt-[3.25rem] flex w-full max-w-60 min-w-0 flex-col">
				<label class="text-xs leading-none font-normal uppercase" for="contact-enquiry">Enquiry type</label>
				<select class="text-base leading-[1.5] font-normal" id="contact-enquiry" name="enquiry" required>
					{enquiryOptions.map((label) => <option value={label}>{label}</option>)}
				</select>
			</div>

			<div class="contact-field mt-[4.75rem] flex min-w-0 flex-col">
				<label class="text-xs leading-none font-normal uppercase" for="contact-message">Message</label>
				<textarea class="text-base leading-[1.5] font-normal" id="contact-message" name="message" required rows="5"></textarea>
			</div>

			<button type="submit" disabled={!formAction} class="contact-submit mt-12 min-h-[3.375rem] w-fit px-6 py-3 text-base leading-none font-normal text-brand-ink">
				Make enquiry
			</button>
		</form>

		<figure class="contact-image m-0">
			<img
				src="/images/services/1-1-photo.jpg"
				alt="A therapist listening thoughtfully during a group session."
				class="h-full w-full object-cover outline-1 -outline-offset-1 outline-black/10"
				loading="lazy"
				decoding="async"
			/>
		</figure>
	</div>
</section>

<style>
	.contact-section { background: #fff; }

	.contact-layout {
		display: grid;
		width: min(100% - 2rem, 104.25rem);
		margin-inline: auto;
		gap: 4.5rem;
	}

	.contact-details a {
		width: fit-content;
		text-decoration-line: underline;
		text-decoration-color: transparent;
		transition-property: text-decoration-color;
		transition-duration: 150ms;
	}

	.contact-details a:hover {
		text-decoration-color: currentColor;
	}

	.contact-field label {
		color: var(--color-brand-ink);
	}

	.contact-field input,
	.contact-field select,
	.contact-field textarea {
		width: 100%;
		min-height: 2.75rem;
		border: 0;
		border-bottom: 1px solid rgb(83 96 93 / 45%);
		border-radius: 0;
		background: transparent;
		font: inherit;
		color: var(--color-brand-ink);
		outline: none;
		transition-property: border-color;
		transition-duration: 150ms;
	}

	.contact-field input:focus,
	.contact-field select:focus,
	.contact-field textarea:focus {
		border-color: var(--color-brand-ink);
	}

	.contact-field select {
		cursor: pointer;
		appearance: none;
	}

	.contact-field textarea {
		min-height: 8.5rem;
		padding-top: 0.75rem;
		resize: vertical;
	}

	.contact-submit {
		background: var(--color-brand-sand);
		transition-property: background-color, color, transform, opacity;
		transition-duration: 150ms;
	}

	.contact-submit:hover:not(:disabled) {
		background: var(--color-brand-mint);
	}

	.contact-submit:active:not(:disabled) {
		transform: scale(0.96);
	}

	.contact-submit:focus-visible {
		outline: 2px solid var(--color-brand-ink);
		outline-offset: 2px;
	}

	.contact-submit:disabled {
		cursor: not-allowed;
		opacity: 0.55;
	}

	.contact-image {
		aspect-ratio: 1.46 / 1;
		overflow: hidden;
		border-radius: 1rem;
	}

	.contact-image img {
		object-position: center 42%;
	}

	@media (min-width: 40rem) {
		.contact-layout {
			width: min(100% - 6rem, 104.25rem);
		}

	}

	@media (min-width: 80rem) {
		.contact-layout {
			grid-template-columns: minmax(17rem, 23rem) minmax(28rem, 35.75rem) minmax(20rem, 33.75rem);
			align-items: start;
			justify-content: space-between;
			column-gap: 6rem;
		}
	}
</style>
