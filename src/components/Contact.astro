---
import "@fontsource-variable/newsreader";

const formAction =
	typeof import.meta.env.PUBLIC_FORMSPREE_ID === "string" &&
	import.meta.env.PUBLIC_FORMSPREE_ID.length > 0
		? `https://formspree.io/f/${import.meta.env.PUBLIC_FORMSPREE_ID}`
		: undefined;

const enquiryOptions = [
	"1:1 Psychotherapy",
	"Group therapy",
	"Child psychotherapy",
	"Body work",
	"Teaching or training",
	"Spaces to rent",
	"Other",
];
---

<section
	id="contact"
	class="border-t border-neutral-200/80 bg-white"
	aria-labelledby="contact-heading"
	style={`padding-top: var(--spacing-section-y); padding-bottom: var(--spacing-section-y);`}
>
	<div class="mx-auto max-w-6xl px-6 lg:px-8">
		<div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16 xl:gap-20">
			<div class="flex flex-col gap-10">
				<div class="flex flex-col gap-4">
					<p class="text-xs font-medium tracking-widest text-neutral-500 uppercase">
						Get in touch
					</p>
					<h2
						id="contact-heading"
						class="max-w-lg font-serif text-4xl font-normal leading-tight tracking-tight text-neutral-900 md:text-5xl"
					>
						We&apos;d be glad to hear from you.
					</h2>
				</div>

				<ul class="flex flex-col gap-8" role="list">
					<li class="flex gap-4">
						<div
							class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-neutral-300 bg-transparent text-neutral-900"
							aria-hidden="true"
						>
							<svg
								class="h-5 w-5"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.25"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<rect x="3" y="5" width="18" height="14" rx="1" />
								<path d="M3 7l9 6 9-6" />
							</svg>
						</div>
						<div class="flex flex-col gap-1 pt-0.5">
							<p class="text-xs font-medium tracking-widest text-neutral-500 uppercase">
								Email us
							</p>
							<a
								href="mailto:hello@ngikhona.co.uk"
								class="text-base text-neutral-900 underline-offset-4 transition-colors hover:text-neutral-600 hover:underline"
							>
								hello@ngikhona.co.uk
							</a>
						</div>
					</li>
					<li class="flex gap-4">
						<div
							class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-neutral-300 bg-transparent text-neutral-900"
							aria-hidden="true"
						>
							<svg
								class="h-5 w-5"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.25"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M12 21s-7-4.35-7-10a7 7 0 0 1 14 0c0 5.65-7 10-7 10z" />
								<circle cx="12" cy="11" r="2.5" />
							</svg>
						</div>
						<div class="flex flex-col gap-1 pt-0.5">
							<p class="text-xs font-medium tracking-widest text-neutral-500 uppercase">
								Location
							</p>
							<p class="text-base text-neutral-900">Camberwell, South London</p>
						</div>
					</li>
				</ul>
			</div>

			<div class="rounded-sm bg-neutral-100/80 p-8 shadow-sm md:p-10 lg:p-12">
				<form
					class="flex flex-col gap-8"
					name="contact"
					method="POST"
					action={formAction}
				>
					<!-- {
						formAction ? (
							<>
								<input type="hidden" name="_subject" value="Ngikhona website enquiry" />
							</>
						) : (
							<p class="rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
								Add{" "}
								<code class="rounded bg-white px-1 py-0.5 text-xs">PUBLIC_FORMSPREE_ID</code> to
								your <code class="rounded bg-white px-1 py-0.5 text-xs">.env</code> file to
								enable form submissions (Formspree).
							</p>
						)
					} -->

					<div class="grid gap-8 sm:grid-cols-2 sm:gap-6">
						<div class="flex flex-col gap-2">
							<label for="contact-name" class="text-xs font-medium tracking-widest text-neutral-500 uppercase">
								Name
							</label>
							<input
								id="contact-name"
								type="text"
								name="name"
								required
								autocomplete="name"
								class="w-full border-0 border-b border-neutral-400 bg-transparent pb-2 text-base text-neutral-900 outline-none transition-colors placeholder:text-neutral-400 focus:border-neutral-900"
								placeholder=""
							/>
						</div>
						<div class="flex flex-col gap-2">
							<label for="contact-email" class="text-xs font-medium tracking-widest text-neutral-500 uppercase">
								Email
							</label>
							<input
								id="contact-email"
								type="email"
								name="email"
								required
								autocomplete="email"
								class="w-full border-0 border-b border-neutral-400 bg-transparent pb-2 text-base text-neutral-900 outline-none transition-colors placeholder:text-neutral-400 focus:border-neutral-900"
								placeholder=""
							/>
						</div>
					</div>

					<div class="flex flex-col gap-2">
						<label for="contact-enquiry" class="text-xs font-medium tracking-widest text-neutral-500 uppercase">
							Enquiry type
						</label>
						<div class="relative">
							<select
								id="contact-enquiry"
								name="enquiry"
								required
								class="contact-select w-full cursor-pointer appearance-none border-0 border-b border-neutral-400 bg-transparent pb-2 pr-8 text-base text-neutral-900 outline-none transition-colors focus:border-neutral-900"
							>
								{
									enquiryOptions.map((label) => (
										<option value={label}>{label}</option>
									))
								}
							</select>
							<span
								class="pointer-events-none absolute right-0 bottom-2 text-neutral-500"
								aria-hidden="true"
							>
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
						</div>
					</div>

					<div class="flex flex-col gap-2">
						<label for="contact-message" class="text-xs font-medium tracking-widest text-neutral-500 uppercase">
							Message
						</label>
						<textarea
							id="contact-message"
							name="message"
							required
							rows="5"
							class="min-h-[140px] w-full resize-y border-0 border-b border-neutral-400 bg-transparent pb-2 text-base leading-relaxed text-neutral-900 outline-none transition-colors placeholder:text-neutral-400 focus:border-neutral-900"
						/>
					</div>

					<button
						type="submit"
						disabled={!formAction}
						class="w-full bg-neutral-900 px-6 py-3.5 text-sm font-medium text-white transition-colors hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 disabled:cursor-not-allowed disabled:opacity-50"
					>
						Send message
					</button>
				</form>
			</div>
		</div>
	</div>
</section>

<style>
	.contact-select {
		background-image: none;
	}
</style>
