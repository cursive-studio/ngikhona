---
const items = [
	{
		title: "1:1 Therapy",
		body: "Individual psychotherapy in a thoughtful, confidential space, tailored to your pace, needs, and circumstances.",
		illustration: "/images/illustrations/1-1-therapy.svg",
		iconColor: "#789b83",
		iconWidth: "4rem",
	},
	{
		title: "Group Therapy",
		body: "Facilitated therapeutic groups that support reflection, connection, and learning in relation with others.",
		illustration: "/images/illustrations/group-thrapy.svg",
		iconColor: "#9297b2",
		iconWidth: "3.875rem",
	},
	{
		title: "Child Psychotherapy",
		body: "Psychotherapeutic support for children and young people, held with care, curiosity, and developmental understanding.",
		illustration: "/images/illustrations/child-therapy.svg",
		iconColor: "#65aa9d",
		iconWidth: "4.25rem",
	},
	{
		title: "Body Work",
		body: "Body-based therapeutic work that attends to how emotional life is experienced, held, and expressed physically.",
		illustration: "/images/illustrations/body-work.svg",
		iconColor: "#aaa06d",
		iconWidth: "4rem",
	},
];
---

<section
	id="services"
	class="services-section py-20 md:py-[6.5rem]"
	aria-labelledby="services-heading"
>
	<div class="site-grid gap-y-16 md:gap-y-20">
		<header class="col-span-4 text-center md:col-start-3 md:col-span-8">
			<p class="mb-4 font-sans text-xs leading-none font-normal tracking-[0.08em] text-brand-sand uppercase">Services</p>
			<h2
				id="services-heading"
				class="font-brand mx-auto max-w-[42rem] text-[26px] leading-[1.05] font-normal tracking-[-0.035em] text-brand-ink [text-wrap:balance] md:text-[28px]"
			>
				We offer a range of psychological services
			</h2>

		</header>

		<div class="col-span-4 grid gap-x-6 gap-y-8 sm:grid-cols-2 md:col-span-12 lg:grid-cols-4">
			{
				items.map((item) => (
					<article class="service-item flex min-h-full flex-col items-center border-t border-brand-ink/15 pt-6 text-center lg:border-t-0 lg:pt-0">
						<div
							class="service-illustration mb-6 h-[4.5rem] w-[4.5rem]"
							style={`--illustration: url('${item.illustration}'); --illustration-color: ${item.iconColor}; --illustration-width: ${item.iconWidth};`}
							aria-hidden="true"
						/>
						<h3 class="font-brand mb-3 text-[22px] leading-[1.1] font-normal tracking-[-0.025em] text-brand-ink md:text-2xl">
							{item.title}
						</h3>
						<p class="mx-auto max-w-[18rem] text-[0.9375rem] leading-[1.5] font-normal text-brand-muted [text-wrap:pretty]">
							{item.body}
						</p>
						<a
							href="#contact"
							class="mt-5 inline-flex min-h-11 w-fit items-center justify-center rounded-full border border-brand-ink/55 px-5 text-sm text-brand-ink transition-[background-color,color,transform] duration-150 hover:bg-brand-ink hover:text-white active:scale-[0.96] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-ink"
						>
							Learn more
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.services-section {
		background: #f5f3ee;
	}

	.service-illustration {
		background-color: var(--illustration-color);
		mask-image: var(--illustration);
		mask-position: center bottom;
		mask-repeat: no-repeat;
		mask-size: var(--illustration-width) auto;
		-webkit-mask-image: var(--illustration);
		-webkit-mask-position: center bottom;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-size: var(--illustration-width) auto;
	}

</style>
